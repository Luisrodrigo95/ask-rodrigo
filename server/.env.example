# Server Configuration
PORT=3005
NODE_ENV=production
CLIENT_URL=https://therodrigo.com

# AI Model Configuration (Optional: native AGy bridge runs on VPS; this is for fallback/guest)
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL=gemini-2.5-flash

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_change_me
ADMIN_PIN=your_custom_admin_pin_here
ADMIN_EMAILS=your_email@gmail.com
PRIMARY_ADMIN_EMAIL=your_email@gmail.com
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Antigravity CLI Paths (Defaults to /usr/bin/agy and /home/bombi)
AGY_BIN_PATH=/usr/bin/agy
AGY_HOME=/home/bombi
